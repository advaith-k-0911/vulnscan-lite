# ==============================================================================
# VulnScan Lite - Production Environment Variables Template
# ==============================================================================
# IMPORTANT: DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL.
# Supply these variables securely via your hosting provider's secret manager.
# ==============================================================================

# 1. Application Settings
APP_NAME=VulnScan Lite
APP_ENV=production
DEBUG=False
HOST=0.0.0.0
PORT=8000

# 2. Cryptographic Secret Key
# Generate a cryptographically random 32-byte string:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_64_HEX_CHARACTERS

# 3. Database Connection
# Production: Managed PostgreSQL instance (recommended)
# Example: postgresql://vulnscan_user:YOUR_DB_PASSWORD@db-host.example.com:5432/vulnscan_prod
DATABASE_URL=postgresql://vulnscan_user:CHANGE_ME_PASSWORD@db-host:5432/vulnscan_db

# 4. Redis Message Broker & Rate Limiting Counter Store
# Production: Managed Redis instance (Private network / TLS enabled)
# Example: redis://:YOUR_REDIS_PASSWORD@redis-host.example.com:6379/0
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis-host:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis-host:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@redis-host:6379/0

# 5. Security & Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_SCAN_CREATION_LIMIT=10
RATE_LIMIT_SCAN_CREATION_WINDOW=60
MAX_REQUEST_BODY_BYTES=65536

# 6. HTTPS & Security Headers
# Enable HSTS only when the application is served over real HTTPS
ENABLE_HSTS=True

# 7. CORS Origins (Comma-separated list of allowed frontend origins)
# Example: https://vulnscan.example.com,https://app.vulnscan.example.com
CORS_ORIGINS=https://vulnscan.yourdomain.com

# 8. Scanner Resource Bounds
SCANNER_TIMEOUT_SECONDS=10
SCANNER_MAX_REDIRECTS=5
SCANNER_MAX_RESPONSE_BYTES=5242880

# 9. Frontend Production Configuration
# When using Nginx reverse proxy on the same domain, leave empty string ("")
# When frontend is on a separate domain/subdomain, provide the backend HTTPS URL
VITE_API_BASE_URL=https://api.vulnscan.yourdomain.com
