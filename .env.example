# VulnScan Lite - Environment Configuration Template
# Copy this file to .env and configure values appropriately.
# NEVER commit real production credentials or secret keys to version control.

# ==============================================================================
# 1. Application & Security Configuration
# ==============================================================================
APP_NAME=VulnScan Lite
APP_ENV=development # Options: development, testing, production
DEBUG=False         # Must be False in production
HOST=127.0.0.1
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production

# ==============================================================================
# 2. Database Configuration
# ==============================================================================
# Local non-Docker development:
DATABASE_URL=sqlite:///./vulnscan.db

# Docker development (persisted in /app/data via named volume):
# DATABASE_URL=sqlite:////app/data/vulnscan.db

# Production PostgreSQL:
# DATABASE_URL=postgresql://vulnscan_user:secure_password@localhost:5432/vulnscan_db

# ==============================================================================
# 3. Redis & Celery Task Queue Configuration
# ==============================================================================
# Local non-Docker development:
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Docker development (uses internal Docker service name):
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# ==============================================================================
# 4. Passive Scanner Operational Bounds
# ==============================================================================
SCANNER_TIMEOUT_SECONDS=10
SCANNER_MAX_REDIRECTS=5
SCANNER_MAX_RESPONSE_BYTES=5242880 # 5 MB

# ==============================================================================
# 5. API Rate Limiting & Safety Controls
# ==============================================================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_SCAN_CREATION_LIMIT=10  # Max scan creation requests per window
RATE_LIMIT_SCAN_CREATION_WINDOW=60 # Window size in seconds
MAX_REQUEST_BODY_BYTES=65536      # 64 KB maximum request payload size

# ==============================================================================
# 6. Security Headers & CORS Configuration
# ==============================================================================
ENABLE_HSTS=False                  # Set to True ONLY when serving over real HTTPS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ==============================================================================
# 7. Frontend Configuration (frontend/.env)
# ==============================================================================
# Local development: VITE_API_BASE_URL=http://127.0.0.1:8000
# Docker / Production: VITE_API_BASE_URL= (empty string routes via Nginx reverse proxy)
